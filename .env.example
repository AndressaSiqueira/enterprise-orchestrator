# Ambiente local — NÃO commitar no Git
# Copie este arquivo para .env e preencha os valores

# Cosmos DB (deixe vazio para usar mock in-memory)
USE_COSMOS=false
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=marketplace
COSMOS_CONTAINER=saas-subscriptions

# Webhook security
WEBHOOK_API_KEY=dev-api-key-change-in-production
