.create-or-alter function with (
    folder = "GitHubCopilotFocus",
    docstring = "Transforms FOCUS-conformant GitHub Copilot cost records to schema version 1.0."
) GitHubCopilotFocus_transform_v1_0() {
    GitHubCopilotFocus_raw
    | extend x_IngestionTime = ingestion_time()
