// Run this file in the Ingestion database.
// Unifies GitHubCopilotBudgets/Seats/UserUsage into one table, discriminated by x_RecordType/x_RowKind.

.create-merge table GitHubCopilot_raw (
    x_RecordType: string,
    x_RowKind: string,
    Organization: string,
    UserLogin: string,
    UserId: long,
    BudgetId: string,
    BudgetType: string,
    BudgetProductSku: string,
    BudgetScope: string,
    BudgetAmount: decimal,
    PreventFurtherUsage: bool,
    BudgetEntityName: string,
    WillAlert: bool,
    AlertRecipientsJson: string,
    ConsumedAmount: decimal,
    TotalSeats: long,
    AssigneeType: string,
    AssigningTeam: string,
    PendingCancellationDate: string,
    LastActivityAt: datetime,
    LastActivityEditor: string,
    LastAuthenticatedAt: datetime,
    CreatedAt: datetime,
    PlanType: string,
    ReportStartDay: datetime,
    ReportEndDay: datetime,
    Day: datetime,
    OrganizationId: long,
    EnterpriseId: string,
    Interactions: long,
    CodeGenerations: long,
    CodeAcceptances: long,
    LocSuggestedToAdd: long,
    LocSuggestedToDelete: long,
    LocAdded: long,
    LocDeleted: long,
    UsedAgent: bool,
    UsedChat: bool,
    UsedCli: bool,
    UsedCopilotCloudAgent: bool,
    UsedCopilotCodingAgent: bool,
    AiAdoptionPhase: string,
    AiCreditProduct: string,
    AiCreditSku: string,
    AiCreditModel: string,
    AiCreditUnitType: string,
    AiCreditPricePerUnit: decimal,
    AiCreditGrossQuantity: decimal,
    AiCreditGrossAmount: decimal,
    AiCreditDiscountQuantity: decimal,
    AiCreditDiscountAmount: decimal,
    AiCreditNetQuantity: decimal,
    AiCreditNetAmount: decimal,
    CollectedAtUtc: datetime,
    SourceFile: string,
    SchemaVersion: string,
    models_used: string,
    otel_request_count: long,
    otel_input_tokens: long,
    otel_output_tokens: long,
    otel_total_tokens: long,
    otel_avg_latency_ms: real,
    otel_session_count: long,
    otel_agents_used: string,
    otel_tool_call_count: long,
    otel_correlation_level: string
)

.create-or-alter table GitHubCopilot_raw ingestion parquet mapping "GitHubCopilot_raw_mapping" '[{"column":"x_RecordType","path":"$.x_RecordType"},{"column":"x_RowKind","path":"$.x_RowKind"},{"column":"Organization","path":"$.Organization"},{"column":"UserLogin","path":"$.UserLogin"},{"column":"UserId","path":"$.UserId"},{"column":"BudgetId","path":"$.BudgetId"},{"column":"BudgetType","path":"$.BudgetType"},{"column":"BudgetProductSku","path":"$.BudgetProductSku"},{"column":"BudgetScope","path":"$.BudgetScope"},{"column":"BudgetAmount","path":"$.BudgetAmount"},{"column":"PreventFurtherUsage","path":"$.PreventFurtherUsage"},{"column":"BudgetEntityName","path":"$.BudgetEntityName"},{"column":"WillAlert","path":"$.WillAlert"},{"column":"AlertRecipientsJson","path":"$.AlertRecipientsJson"},{"column":"ConsumedAmount","path":"$.ConsumedAmount"},{"column":"TotalSeats","path":"$.TotalSeats"},{"column":"AssigneeType","path":"$.AssigneeType"},{"column":"AssigningTeam","path":"$.AssigningTeam"},{"column":"PendingCancellationDate","path":"$.PendingCancellationDate"},{"column":"LastActivityAt","path":"$.LastActivityAt"},{"column":"LastActivityEditor","path":"$.LastActivityEditor"},{"column":"LastAuthenticatedAt","path":"$.LastAuthenticatedAt"},{"column":"CreatedAt","path":"$.CreatedAt"},{"column":"PlanType","path":"$.PlanType"},{"column":"ReportStartDay","path":"$.ReportStartDay"},{"column":"ReportEndDay","path":"$.ReportEndDay"},{"column":"Day","path":"$.Day"},{"column":"OrganizationId","path":"$.OrganizationId"},{"column":"EnterpriseId","path":"$.EnterpriseId"},{"column":"Interactions","path":"$.Interactions"},{"column":"CodeGenerations","path":"$.CodeGenerations"},{"column":"CodeAcceptances","path":"$.CodeAcceptances"},{"column":"LocSuggestedToAdd","path":"$.LocSuggestedToAdd"},{"column":"LocSuggestedToDelete","path":"$.LocSuggestedToDelete"},{"column":"LocAdded","path":"$.LocAdded"},{"column":"LocDeleted","path":"$.LocDeleted"},{"column":"UsedAgent","path":"$.UsedAgent"},{"column":"UsedChat","path":"$.UsedChat"},{"column":"UsedCli","path":"$.UsedCli"},{"column":"UsedCopilotCloudAgent","path":"$.UsedCopilotCloudAgent"},{"column":"UsedCopilotCodingAgent","path":"$.UsedCopilotCodingAgent"},{"column":"AiAdoptionPhase","path":"$.AiAdoptionPhase"},{"column":"AiCreditProduct","path":"$.AiCreditProduct"},{"column":"AiCreditSku","path":"$.AiCreditSku"},{"column":"AiCreditModel","path":"$.AiCreditModel"},{"column":"AiCreditUnitType","path":"$.AiCreditUnitType"},{"column":"AiCreditPricePerUnit","path":"$.AiCreditPricePerUnit"},{"column":"AiCreditGrossQuantity","path":"$.AiCreditGrossQuantity"},{"column":"AiCreditGrossAmount","path":"$.AiCreditGrossAmount"},{"column":"AiCreditDiscountQuantity","path":"$.AiCreditDiscountQuantity"},{"column":"AiCreditDiscountAmount","path":"$.AiCreditDiscountAmount"},{"column":"AiCreditNetQuantity","path":"$.AiCreditNetQuantity"},{"column":"AiCreditNetAmount","path":"$.AiCreditNetAmount"},{"column":"CollectedAtUtc","path":"$.CollectedAtUtc"},{"column":"SourceFile","path":"$.SourceFile"},{"column":"SchemaVersion","path":"$.SchemaVersion"},{"column":"models_used","path":"$.models_used"},{"column":"otel_request_count","path":"$.otel_request_count"},{"column":"otel_input_tokens","path":"$.otel_input_tokens"},{"column":"otel_output_tokens","path":"$.otel_output_tokens"},{"column":"otel_total_tokens","path":"$.otel_total_tokens"},{"column":"otel_avg_latency_ms","path":"$.otel_avg_latency_ms"},{"column":"otel_session_count","path":"$.otel_session_count"},{"column":"otel_agents_used","path":"$.otel_agents_used"},{"column":"otel_tool_call_count","path":"$.otel_tool_call_count"},{"column":"otel_correlation_level","path":"$.otel_correlation_level"}]'

.create-merge table GitHubCopilot_final_v1_0 (
    x_RecordType: string,
    x_RowKind: string,
    Organization: string,
    UserLogin: string,
    UserId: long,
    BudgetId: string,
    BudgetType: string,
    BudgetProductSku: string,
    BudgetScope: string,
    BudgetAmount: decimal,
    PreventFurtherUsage: bool,
    BudgetEntityName: string,
    WillAlert: bool,
    AlertRecipientsJson: string,
    ConsumedAmount: decimal,
    TotalSeats: long,
    AssigneeType: string,
    AssigningTeam: string,
    PendingCancellationDate: string,
    LastActivityAt: datetime,
    LastActivityEditor: string,
    LastAuthenticatedAt: datetime,
    CreatedAt: datetime,
    PlanType: string,
    ReportStartDay: datetime,
    ReportEndDay: datetime,
    Day: datetime,
    OrganizationId: long,
    EnterpriseId: string,
    Interactions: long,
    CodeGenerations: long,
    CodeAcceptances: long,
    LocSuggestedToAdd: long,
    LocSuggestedToDelete: long,
    LocAdded: long,
    LocDeleted: long,
    UsedAgent: bool,
    UsedChat: bool,
    UsedCli: bool,
    UsedCopilotCloudAgent: bool,
    UsedCopilotCodingAgent: bool,
    AiAdoptionPhase: string,
    AiCreditProduct: string,
    AiCreditSku: string,
    AiCreditModel: string,
    AiCreditUnitType: string,
    AiCreditPricePerUnit: decimal,
    AiCreditGrossQuantity: decimal,
    AiCreditGrossAmount: decimal,
    AiCreditDiscountQuantity: decimal,
    AiCreditDiscountAmount: decimal,
    AiCreditNetQuantity: decimal,
    AiCreditNetAmount: decimal,
    CollectedAtUtc: datetime,
    SourceFile: string,
    SchemaVersion: string,
    x_IngestionTime: datetime,
    models_used: string,
    otel_request_count: long,
    otel_input_tokens: long,
    otel_output_tokens: long,
    otel_total_tokens: long,
    otel_avg_latency_ms: real,
    otel_session_count: long,
    otel_agents_used: string,
    otel_tool_call_count: long,
    otel_correlation_level: string
)

.create-or-alter function with (
    folder = "GitHubCopilot",
    docstring = "Transforms unified GitHub Copilot records to schema version 1.0."
) GitHubCopilot_transform_v1_0() {
    GitHubCopilot_raw
    | extend x_IngestionTime = ingestion_time()
    | project
        x_RecordType, x_RowKind, Organization, UserLogin, UserId,
        BudgetId, BudgetType, BudgetProductSku, BudgetScope, BudgetAmount,
        PreventFurtherUsage, BudgetEntityName, WillAlert, AlertRecipientsJson,
        ConsumedAmount, TotalSeats, AssigneeType, AssigningTeam,
        PendingCancellationDate, LastActivityAt, LastActivityEditor,
        LastAuthenticatedAt, CreatedAt, PlanType, ReportStartDay, ReportEndDay,
        Day, OrganizationId, EnterpriseId, Interactions, CodeGenerations,
        CodeAcceptances, LocSuggestedToAdd, LocSuggestedToDelete, LocAdded,
        LocDeleted, UsedAgent, UsedChat, UsedCli, UsedCopilotCloudAgent,
        UsedCopilotCodingAgent, AiAdoptionPhase,
        CollectedAtUtc, SourceFile,
        SchemaVersion, x_IngestionTime,
        AiCreditProduct, AiCreditSku, AiCreditModel, AiCreditUnitType,
        AiCreditPricePerUnit, AiCreditGrossQuantity, AiCreditGrossAmount,
        AiCreditDiscountQuantity, AiCreditDiscountAmount, AiCreditNetQuantity,
        AiCreditNetAmount,
        models_used, otel_request_count, otel_input_tokens, otel_output_tokens,
        otel_total_tokens, otel_avg_latency_ms, otel_session_count,
        otel_agents_used, otel_tool_call_count, otel_correlation_level
}

.alter table GitHubCopilot_final_v1_0 policy update '[{"IsEnabled":true,"Source":"GitHubCopilot_raw","Query":"GitHubCopilot_transform_v1_0()","IsTransactional":true,"PropagateIngestionProperties":true}]'
