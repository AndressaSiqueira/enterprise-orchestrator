// Run this file in the Hub database after the Ingestion GitHubCopilotFocus script succeeds.
// Exposes the FOCUS-conformant GitHubCopilotFocus table with public function names,
// following the same folder/naming convention as GitHubCopilot.kql.

.create-or-alter function with (
    folder = "GitHubCopilot",
    docstring = "Gets the FOCUS-conformant GitHub Copilot cost records aligned to schema version 1.0."
) GitHubCopilotFocusHistory_v1_0() {
    database("Ingestion").GitHubCopilotFocus_final_v1_0
}

.create-or-alter function with (
    folder = "GitHubCopilot",
    docstring = "Gets the FOCUS-conformant GitHub Copilot cost records with the latest supported schema."
) GitHubCopilotFocus() {
    GitHubCopilotFocusHistory_v1_0()
}
